{
  "platform": {
    "apiRuntime": "node:20"
  },
  "navigationFallback": {
    "rewrite": "/login.html",
    "exclude": ["/css/*", "/js/*", "/img/*", "/api/*", "*.html"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "routes": [
    {
      "route": "/dev-server.js",
      "statusCode": 404
    },
    {
      "route": "/README.md",
      "statusCode": 404
    }
  ]
}
